# ==========================================
# Last.fm API Configuration
# ==========================================
# 1. Create a free Last.fm API account at: https://www.last.fm/api/account/create
# 2. Enter your API Key and Last.fm username below:
LASTFM_API_KEY=
LASTFM_USERNAME=

# ==========================================
# Letterboxd Configuration
# ==========================================
# No API key required! The telemetry engine fetches your public RSS diary at:
# https://letterboxd.com/<username>/rss/
LETTERBOXD_USERNAME=
